                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    FechaTransaccion,
    ClienteId,
    CanalVenta,
    Departamento,
    Municipio,
    ProductoSKU,
    CantidadVendida,
    ExistenciaAntesVenta AS InventarioInicial,
    ExistenciaDespuesVenta AS InventarioFinal,
    PrecioUnitario,
    CostoUnitario,
    DescuentoAplicado AS Descuento,
    TotalLinea AS ImporteNeto,
    ((PrecioUnitario - CostoUnitario) * CantidadVendida - DescuentoAplicado) AS MargenEstimado
FROM SGFoodOLTP.dbo.TransaccionesVenta
WHERE FechaTransaccion IS NOT NULL
  AND ClienteId IS NOT NULL
  AND CanalVenta IS NOT NULL
  AND Departamento IS NOT NULL
  AND Municipio IS NOT NULL
  AND ProductoSKU IS NOT NULL;</property>
