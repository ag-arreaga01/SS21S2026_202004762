                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CAST(FechaTransaccion AS date) AS FechaCompleta,
    CAST(CONVERT(char(8), FechaTransaccion, 112) AS int) AS FechaKey,
    CAST(YEAR(FechaTransaccion) AS smallint) AS Anio,
    CAST(DATEPART(QUARTER, FechaTransaccion) AS tinyint) AS Trimestre,
    CAST(MONTH(FechaTransaccion) AS tinyint) AS Mes,
    CAST(DATENAME(MONTH, FechaTransaccion) AS nvarchar(20)) AS NombreMes,
    CAST(DAY(FechaTransaccion) AS tinyint) AS Dia,
    CAST(DATENAME(WEEKDAY, FechaTransaccion) AS nvarchar(20)) AS NombreDiaSemana,
    CAST(CASE WHEN DATEPART(WEEKDAY, FechaTransaccion) IN (1,7) THEN 1 ELSE 0 END AS bit) AS EsFinDeSemana
FROM SGFoodOLTP.dbo.TransaccionesVenta
WHERE FechaTransaccion IS NOT NULL;</property>
